# Copy to .env and fill in what you have. Everything is optional: without
# keys BlackCell still produces complete videos using its built-in fallbacks.

# --- App ---------------------------------------------------------------
# Public URL people use to reach the app. Used for OAuth redirect URIs.
# Dev default: http://localhost:5173   Production: https://your-domain.com
# APP_URL=http://localhost:5173
# Secret for sessions + token encryption. Auto-generated into data/.secret if unset.
# APP_SECRET=
# PORT=4100            # production port (hosts like Railway set this)
# DATA_DIR=./data      # SQLite DB, rendered videos, caches
# --- Payments (Paystack) -------------------------------------------------
# With a secret key set, plans are sold as monthly Paystack subscriptions and
# creating videos requires an active one. Plans are created in Paystack
# automatically. Use sk_test_... to test (admins then go through checkout too).
# Webhook URL (Paystack dashboard > Settings > API Keys & Webhooks):
# {APP_URL}/api/paystack/webhook
PAYSTACK_SECRET_KEY=
# Prices are shown in US dollars. Paystack charges in your account's currency
# (rand in South Africa; USD only for Kenya/Nigeria), converted at the day's rate.
# PAYSTACK_CURRENCY=ZAR          # blank = your account's currency
# PAYSTACK_EXCHANGE_RATE=16.3    # fix the rate (units per 1 USD) instead of the daily one
# PAYSTACK_PRICES=free=99,starter=310,daily=640,pro=1130   # or fix exact amounts
# BILLING_PROVIDER=paystack      # only needed if both Paystack and Stripe keys are set
# --- Payments (Stripe, alternative) ---------------------------------------
# With a secret key set, plans are sold as monthly Stripe subscriptions and
# creating videos requires an active one. Products/prices are created in
# Stripe automatically. Webhook endpoint: {APP_URL}/api/stripe/webhook, events:
# checkout.session.completed, customer.subscription.created/updated/deleted.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# STRIPE_CURRENCY=usd            # e.g. gbp; prices are the catalog amounts in this currency
# Emails with full access without a subscription (you, staff, testers):
# ADMIN_EMAILS=you@example.com
# Without payments, plan switching is free in dev only (DEMO_BILLING=true allows it anywhere).
# DEMO_BILLING=false
# Who can create accounts: open (default) or invite (only ALLOWED_EMAILS).
# SIGNUP_MODE=invite
# ALLOWED_EMAILS=you@example.com,friend@example.com

# --- Scriptwriting (Claude) ---------------------------------------------
# Without it, scripts come from a small built-in sample library.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5

# --- Images -------------------------------------------------------------
# auto = OpenAI if OPENAI_API_KEY is set, otherwise procedural art.
# pollinations = free keyless image API (prompts are sent to image.pollinations.ai).
# IMAGE_PROVIDER=auto
OPENAI_API_KEY=
# Flagship model by default; falls back to gpt-image-1 if your account lacks it.
# OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst   # or gpt-image-2.5-flare (faster/cheaper)
# OPENAI_IMAGE_QUALITY=high                   # low | medium | high (newer models also: xhigh, max)
# OPENAI_IMAGE_SIZE=1088x1920                 # default: native 9:16 on newer models

# --- AI video clips -------------------------------------------------------
# Google Veo via the Gemini API (preferred when set; paid, no free tier).
# Key from https://aistudio.google.com/apikey on a project with billing enabled.
# Veo 3.1 Lite at 720p: about $0.05/s, so a 4-second hook costs about $0.20.
GEMINI_API_KEY=
# GOOGLE_VIDEO_MODEL=veo-3.1-lite-generate-preview   # or veo-3.1-fast-generate-preview
# GOOGLE_VIDEO_RESOLUTION=720p                      # 1080p/4k require 8-second clips
# VIDEO_PROVIDER=google                             # force google | fal when both keys are set

# fal.ai key: scene images become real AI video clips (image-to-video), timed
# to the narration. Per series, choose "AI video hook" (opening scene only,
# LTX-2.3 Fast, about $0.36/video) or "AI video, every scene" (Kling v3 Pro,
# about $0.112/s). Without a key, scenes are animated stills (pan & zoom).
FAL_KEY=
# FAL_HOOK_MODEL=fal-ai/ltx-2.3/image-to-video/fast
# HOOK_SCENES=1
# FAL_VIDEO_MODEL=fal-ai/kling-video/v3/pro/image-to-video
# FAL_VIDEO_DURATIONS=          # e.g. "5,10" for models with fixed clip lengths
# JOB_CONCURRENCY=3             # videos in progress at once (clips wait on fal)

# --- Voiceover ------------------------------------------------------------
# auto = ElevenLabs → OpenAI → system voice (macOS `say` / espeak-ng) → silent.
# TTS_PROVIDER=auto
ELEVENLABS_API_KEY=
# Most expressive model by default; falls back to eleven_multilingual_v2.
# ELEVENLABS_MODEL=eleven_v3
# Pin any narrator persona to a voice from your ElevenLabs library (voice ID):
# ELEVENLABS_VOICE_ONYX=   ELEVENLABS_VOICE_FABLE=   ELEVENLABS_VOICE_ECHO=   ELEVENLABS_VOICE_ASH=
# ELEVENLABS_VOICE_NOVA=   ELEVENLABS_VOICE_SHIMMER= ELEVENLABS_VOICE_CORAL=  ELEVENLABS_VOICE_SAGE=
# OPENAI_TTS_MODEL=gpt-4o-mini-tts

# --- Posting --------------------------------------------------------------
# Redirect URIs to register with each platform:
#   {APP_URL}/api/accounts/youtube/callback     (+ {APP_URL}/api/auth/google/callback for Google sign-in)
#   {APP_URL}/api/accounts/tiktok/callback
#   {APP_URL}/api/accounts/instagram/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# YOUTUBE_PRIVACY=public
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# INSTAGRAM_GRAPH_VERSION=v23.0
# Instagram downloads videos from a URL, so it must be publicly reachable
# (defaults to APP_URL; set this when developing behind a tunnel).
# PUBLIC_MEDIA_URL=

# --- Rendering ------------------------------------------------------------
# RENDER_WIDTH=1080
# RENDER_HEIGHT=1920
# RENDER_FPS=30
# RENDER_CRF=18          # x264 quality: lower = better (18 ≈ visually lossless)
# RENDER_PRESET=medium   # slower presets = smaller files at the same quality
# RENDER_CONCURRENCY=1
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
# SCHEDULER=on          # set to "off" to disable autopilot on this instance
